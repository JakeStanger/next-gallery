// `prisma-client-js` emits plain JS into node_modules/.prisma/client with
// conditional exports (node / workerd). The newer TS `prisma-client`
// generator is compiled into the app bundle instead, which Cloudflare's
// OpenNext adapter cannot currently bundle (WASM query compiler).
generator client {
  provider = "prisma-client-js"
}

// Cloudflare D1. Accessed through the `DB` binding with the D1 driver adapter
// (lib/client/prisma.ts); schema changes are applied with
// `wrangler d1 migrations apply` (see prisma/migrations).
datasource db {
  provider = "sqlite"
}

model Category {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  images Image[]
}

model Group {
  id   Int    @id @default(autoincrement())
  name String @unique

  primaryImage   Image? @relation(name: "PrimaryImage", fields: [primaryImageId], references: [id])
  primaryImageId Int?

  images Image[] @relation("ImageGroup")
}

model Image {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  width       Int
  height      Int
  exposure    Float?
  focalLength Float?
  aperture    Float?
  iso         Int?
  cameraModel String?
  timeTaken   DateTime?

  categories   Category[]
  location     Location?   @relation(fields: [locationId], references: [id])
  tags         Tag[]
  priceGroup   PriceGroup? @relation(fields: [priceGroupId], references: [id])
  locationId   Int?
  priceGroupId Int?

  group   Group?  @relation(name: "ImageGroup", fields: [groupId], references: [id])
  groupId Int?
  Group   Group[] @relation("PrimaryImage")
}

model Location {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  images Image[]
}

model Price {
  id          Int    @id @default(autoincrement())
  name        String
  cost        Float
  costPostage Float?

  priceGroup   PriceGroup @relation(fields: [priceGroupId], references: [id])
  priceGroupId Int
}

model PriceGroup {
  id            Int     @id @default(autoincrement())
  name          String  @unique
  priceTypeName String?

  images Image[]
  prices Price[]
}

model Tag {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  images Image[]
}
