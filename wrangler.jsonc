{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "next-gallery",
  // Custom entry wrapping the OpenNext worker (.open-next/worker.js) with Sentry
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "rstanger.co.uk", "custom_domain": true },
    { "pattern": "www.rstanger.co.uk", "custom_domain": true }
  ],
  "services": [
    {
      // Self-reference used by OpenNext for ISR revalidation.
      // The service name must match the worker name above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "next-gallery"
    }
  ],
  "r2_buckets": [
    {
      // ISR / incremental cache storage
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "rstanger-opennext-cache"
    },
    {
      // Public bucket served at NEXT_PUBLIC_CDN_URL: thumb/<id>.webp, marked/<id>.webp
      "binding": "IMAGES_BUCKET",
      "bucket_name": "rstanger-images"
    },
    {
      // Private bucket for original uploads: raw/<id>.<ext>
      "binding": "ORIGINALS_BUCKET",
      "bucket_name": "rstanger-images-raw"
    }
  ],
  "queues": {
    "producers": [
      {
        // Consumed by workers/image-processor
        "binding": "IMAGE_QUEUE",
        "queue": "image-processing"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        // Queue for time-based ISR revalidation (`revalidate` in getStaticProps)
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rstanger-db",
      // Create with `wrangler d1 create rstanger-db` and paste the id here.
      "database_id": "<D1_DATABASE_ID>",
      "migrations_dir": "prisma/migrations"
    }
  ],
  // Non-secret runtime configuration. Secrets (NEXTAUTH_SECRET, GOOGLE_CLIENT_SECRET,
  // STRIPE_SECRET_KEY, API_TOKEN, ...) are set with `wrangler secret put`.
  "vars": {
    "NEXTAUTH_URL": "https://rstanger.co.uk"
  },
  "env": {
    // Environments used only by `next build` for static generation, which needs
    // nothing but the database (selected with NEXT_DEV_WRANGLER_ENV, see the
    // build scripts). Never deployed.
    // - local-db: the local D1 database (`npm run preview`)
    // - remote-db: the production D1 database (`npm run deploy` / `upload`)
    "local-db": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rstanger-db",
          "database_id": "<D1_DATABASE_ID>",
          "migrations_dir": "prisma/migrations"
        }
      ]
    },
    "remote-db": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rstanger-db",
          "database_id": "<D1_DATABASE_ID>",
          "migrations_dir": "prisma/migrations",
          "remote": true
        }
      ]
    }
  }
}
